generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String      @id @default(uuid())
  nombre       String
  email        String      @unique
  passwordHash String
  fotoUrl      String?
  direccion    String?
  reputacion   Float       @default(0)
  creadoEn     DateTime    @default(now())

  objetos     Objeto[]
  solicitudes Solicitud[] @relation("Solicitante")
  resenas     Resena[]    @relation("Autor")
}

model Objeto {
  id          String      @id @default(uuid())
  titulo      String
  descripcion String
  categoria   String
  estado      String      @default("disponible")
  fotoUrl     String?
  disponible  Boolean     @default(true)
  creadoEn    DateTime    @default(now())

  dueno       Usuario     @relation(fields: [duenoId], references: [id])
  duenoId     String

  solicitudes Solicitud[]
}

model Solicitud {
  id            String    @id @default(uuid())
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        String    @default("pendiente")
  mensaje       String?
  creadoEn      DateTime  @default(now())

  solicitante   Usuario   @relation("Solicitante", fields: [solicitanteId], references: [id])
  solicitanteId String

  objeto        Objeto    @relation(fields: [objetoId], references: [id])
  objetoId      String

  resenas       Resena[]
}

model Resena {
  id          String    @id @default(uuid())
  puntuacion  Int
  comentario  String?
  creadoEn    DateTime  @default(now())

  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String

  autor       Usuario   @relation("Autor", fields: [autorId], references: [id])
  autorId     String
}